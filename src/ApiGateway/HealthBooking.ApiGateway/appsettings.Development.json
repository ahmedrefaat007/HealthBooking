{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServer": {
    "Authority": "http://localhost:5005"
  },
  "ReverseProxy": {
    "Clusters": {
      "patient-cluster": {
        "Destinations": {
          "patient-service": { "Address": "http://localhost:5001" }
        }
      },
      "provider-cluster": {
        "Destinations": {
          "provider-service": { "Address": "http://localhost:5002" }
        }
      },
      "appointment-cluster": {
        "Destinations": {
          "appointment-service": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
