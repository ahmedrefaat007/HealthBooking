{
  "IdentityServer": {
    "Authority": "http://identity-server:5005"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:5000" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "patient-register-route": {
        "ClusterId": "patient-cluster",
        "Match": { "Path": "/api/patients/register" },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-For", "Set": "{RemoteIpAddress}" }
        ]
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "AuthorizationPolicy": "JwtBearer",
        "Match": { "Path": "/api/patients/{**remainder}" },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-For", "Set": "{RemoteIpAddress}" }
        ]
      },
      "provider-route": {
        "ClusterId": "provider-cluster",
        "AuthorizationPolicy": "JwtBearer",
        "Match": { "Path": "/api/providers/{**remainder}" },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-For", "Set": "{RemoteIpAddress}" }
        ]
      },
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "AuthorizationPolicy": "JwtBearer",
        "Match": { "Path": "/api/appointments/{**remainder}" },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-For", "Set": "{RemoteIpAddress}" }
        ]
      }
    },
    "Clusters": {
      "patient-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "patient-service": {
            "Address": "http://patient-service:5001"
          }
        }
      },
      "provider-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "provider-service": {
            "Address": "http://provider-service:5002"
          }
        }
      },
      "appointment-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "appointment-service": {
            "Address": "http://appointment-service:5003"
          }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "OtelExporter": {
    "Endpoint": "http://localhost:4317"
  }
}
