# SQL Server
SQL_SA_PASSWORD=YourSecurePassword123!
MSSQL_SA_PASSWORD=YourSecurePassword123!

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Redis
REDIS_PASSWORD=redis-secure-password

# IdentityServer
IDENTITY_DB_CONNSTRING=Server=sqlserver-identity,1433;Database=IdentityServerDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=true;Encrypt=false
IDENTITY_SERVER_URL=http://identity-server:5005

# PatientService
PATIENT_DB_CONNSTRING=Server=sqlserver-patient,1433;Database=HealthbookingPatientDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=true;Encrypt=false
PATIENT_SERVICE_URL=http://patient-service:5001

# ProviderService
PROVIDER_DB_CONNSTRING=Server=sqlserver-provider,1433;Database=HealthbookingProviderDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=true;Encrypt=false
PROVIDER_SERVICE_URL=http://provider-service:5002
REDIS_URL=redis://redis:6379?password=redis-secure-password

# AppointmentService
APPOINTMENT_DB_CONNSTRING=Server=sqlserver-appointment,1433;Database=HealthbookingAppointmentDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=true;Encrypt=false
APPOINTMENT_SERVICE_URL=http://appointment-service:5003

# NotificationService
NOTIFICATION_DB_CONNSTRING=Server=sqlserver-notification,1433;Database=HealthbookingNotificationDb;User Id=sa;Password=YourSecurePassword123!;TrustServerCertificate=true;Encrypt=false
NOTIFICATION_SERVICE_URL=http://notification-service:5004

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Jaeger
JAEGER_OTLP_ENDPOINT=http://jaeger:4317
